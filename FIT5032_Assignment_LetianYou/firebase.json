{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/ratings",
        "function": {
          "functionId": "accountApi",
          "region": "australia-southeast1"
        }
      },
      {
        "source": "/api/accounts",
        "function": {
          "functionId": "accountApi",
          "region": "australia-southeast1"
        }
      },
      {
        "source": "/api/accounts/**",
        "function": {
          "functionId": "accountApi",
          "region": "australia-southeast1"
        }
      },
      {
        "source": "/api/email",
        "function": {
          "functionId": "sendEmail",
          "region": "australia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "private, no-store, max-age=0"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "database": "letianyou",
    "rules": "firestore.rules"
  }
}
